# Loaded by reusable-super-linter.yaml into Super-Linter's environment.
# docs/diagrams is generated by the archify skill; don't lint generated output.
FILTER_REGEX_EXCLUDE=docs/diagrams/.*
# Biome scans the whole tree (ignoring the exclude above) and duplicates ESLint + Prettier.
VALIDATE_BIOME_FORMAT=false
VALIDATE_BIOME_LINT=false
