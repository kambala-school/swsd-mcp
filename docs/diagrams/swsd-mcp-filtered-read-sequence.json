  "cards": [
    {
      "dot": "cyan",
      "title": "Read path",
      "items": [
        "Assignee filtering scans pages locally because SWSD ignores raw assignee parameters",
        "The default scan cap is 20 pages per requested incident state"
      ]
    },
    {
      "dot": "orange",
      "title": "Retry boundary",
      "items": [
        "GET retries transient failures twice with 500ms then 1000ms fallback delays",
        "POST and PUT never enter this retry path"
      ]
    },
    {
      "dot": "rose",
      "title": "Truthful result",
      "items": [
        "A capped full page returns complete=false and truncated=true",
        "Tool errors become MCP isError responses instead of terminating the server"
      ]
    }
  ]
